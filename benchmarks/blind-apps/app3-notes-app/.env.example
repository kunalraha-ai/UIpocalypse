# Supabase connection settings.
#
# For local development, start the stack in this project with
# `npx supabase start` — it serves the API on http://127.0.0.1:54331
# (ports are configured in supabase/config.toml) and prints the current keys
# (`npx supabase status` shows them again at any time). The values below match
# the local stack out of the box.
#
# For a hosted project, copy these values from
# Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=http://127.0.0.1:54331
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
